# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment Provider: 'mock' or 'cybersource'
PAYMENT_PROVIDER=mock

# CyberSource (fill when ready)
CYBERSOURCE_MERCHANT_ID=
CYBERSOURCE_API_KEY_ID=
CYBERSOURCE_API_SHARED_SECRET=
CYBERSOURCE_FLEX_PUBLIC_KEY=
CYBERSOURCE_ENVIRONMENT=sandbox

# QR Code Security
QR_SIGNING_SECRET=change-this-to-a-random-string

# Email (Resend)
RESEND_API_KEY=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
